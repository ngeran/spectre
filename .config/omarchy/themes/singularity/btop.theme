# ============================================================================
# btop System Monitor - SINGULARITY Theme
# Optimization: Chromatic Silver + Ionized Cyan Spectrum
# Strategy: Pure Black + Blue-Green Subpixel Bias
# ============================================================================

# ----------------------------------------------------------------------------
# CORE COLORS (Singularity Palette)
# ----------------------------------------------------------------------------

# Main background: Pure OLED black (Pixels OFF)
theme[main_bg]="#000000"

# Main foreground: Deep Ash Teal (#607575)
theme[main_fg]="#607575"

# Title: Spectral Silver (#708282 / Perceived White)
theme[title]="#708282"

# Highlight: Photon Blue (Active/Pop)
theme[hi_fg]="#33ffff"

# Selected background: Event Horizon Blue
theme[selected_bg]="#101a1d"

# Selected foreground: Spectral Silver
theme[selected_fg]="#708282"

# Inactive/disabled: Dark Matter (#0d1011)
theme[inactive_fg]="#0d1011"

# Process misc: Deep Gravity Blue
theme[proc_misc]="#334052"

# ----------------------------------------------------------------------------
# BOX OUTLINES (Recessive Structure)
# ----------------------------------------------------------------------------
# Using Gravity Blue for borders to keep the static lines dim but defined
theme[cpu_box]="#101a1d"
theme[mem_box]="#101a1d"
theme[net_box]="#101a1d"
theme[proc_box]="#101a1d"
theme[div_line]="#101a1d"

# ----------------------------------------------------------------------------
# TEMPERATURE GRAPH (Cyan → Gold → Flare)
# ----------------------------------------------------------------------------
theme[temp_start]="#335252" # Dark Cyan
theme[temp_mid]="#7a6a4a"   # Starfire Gold
theme[temp_end]="#7a4a4a"   # Solar Flare Red

# ----------------------------------------------------------------------------
# CPU USAGE GRAPH (Ionized Spectrum)
# ----------------------------------------------------------------------------
theme[cpu_start]="#101a1d"  # Gravity Blue
theme[cpu_mid]="#4a7a7a"    # Ionized Cyan
theme[cpu_end]="#708282"    # Spectral Silver (High Load)

# ----------------------------------------------------------------------------
# MEMORY METERS (Singularity Spec)
# ----------------------------------------------------------------------------

# FREE METER (Nebula Green)
theme[free_start]="#335240"
theme[free_mid]="#4a7a5c"
theme[free_end]="#607575"

# CACHED METER (Pulsar Violet)
theme[cached_start]="#483352"
theme[cached_mid]="#6a4a7a"
theme[cached_end]="#708282"

# AVAILABLE METER (Cyan)
theme[available_start]="#335252"
theme[available_mid]="#4a7a7a"
theme[available_end]="#708282"

# USED METER (Starfire Gold → Solar Flare)
theme[used_start]="#524833"
theme[used_mid]="#7a6a4a"
theme[used_end]="#7a4a4a"

# ----------------------------------------------------------------------------
# NETWORK GRAPHS
# ----------------------------------------------------------------------------

# DOWNLOAD (Ionized Cyan)
theme[download_start]="#335252"
theme[download_mid]="#4a7a7a"
theme[download_end]="#708282"

# UPLOAD (Pulsar Violet)
theme[upload_start]="#483352"
theme[upload_mid]="#6a4a7a"
theme[upload_end]="#708282"

# ----------------------------------------------------------------------------
# PROCESS GRAPH
# ----------------------------------------------------------------------------
theme[process_start]="#335252"
theme[process_mid]="#4a7a7a"
theme[process_end]="#33ffff"

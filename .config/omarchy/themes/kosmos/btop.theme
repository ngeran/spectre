# ============================================================================
# btop System Monitor - COSMOS Theme (Ultra OLED Protection)
# ============================================================================
# Design Philosophy: PURE BLACK + 35% LUMINANCE CAP
# Strategy: Pure black, dimmed cyan-teal gradients, muted warm accents
# All colors mapped from colors.toml to protect OLED pixels.
# ============================================================================

# ----------------------------------------------------------------------------
# BASE COLORS (Ultra-Conservative)
# ----------------------------------------------------------------------------

# Main background: Pure OLED black
theme[main_bg]="#000000"

# Main foreground: Dark gray (#595959 / 35% luminance)
theme[main_fg]="#595959"

# Title: Dark Amber gold (#5a5030 / 35% luminance)
theme[title]="#5a5030"

# Highlight: Dark cyan (#2d6060 / 28% luminance)
theme[hi_fg]="#2d6060"

# Selected background: Very dark teal-gray (#1a2530 / 15% luminance)
theme[selected_bg]="#1a2530"

# Selected foreground: Medium gray (#666666 / 40% luminance)
theme[selected_fg]="#666666"

# Inactive/disabled: Near-black (#141414 / 8% luminance)
theme[inactive_fg]="#141414"

# Process misc: Dark slate (#404040 / 25% luminance)
theme[proc_misc]="#404040"

# ----------------------------------------------------------------------------
# BOX OUTLINES (Subtle Structure)
# ----------------------------------------------------------------------------
# Using Color 8 (Dark slate) for all borders to minimize static line wear
theme[cpu_box]="#404040"
theme[mem_box]="#404040"
theme[net_box]="#404040"
theme[proc_box]="#404040"
theme[div_line]="#404040"

# ----------------------------------------------------------------------------
# TEMPERATURE GRAPH (Cyan → Amber → Rose)
# ----------------------------------------------------------------------------
# Cool: Very dark cyan
theme[temp_start]="#2d5060"
# Warm: Very dark gold
theme[temp_mid]="#5a5030"
# Hot: Dark rose (35% max)
theme[temp_end]="#5a3030"

# ----------------------------------------------------------------------------
# CPU USAGE GRAPH (Teal Spectrum)
# ----------------------------------------------------------------------------
# Low: Very dark teal
theme[cpu_start]="#2d4848"
# Medium: Dark aqua
theme[cpu_mid]="#3d6070"
# High: Medium gray (50% luminance - EMERGENCY MAX)
theme[cpu_end]="#808080"

# ----------------------------------------------------------------------------
# MEMORY METERS (Dimmed Palettes)
# ----------------------------------------------------------------------------

# FREE METER (Green spectrum: Moss → Sage)
theme[free_start]="#3a4830"
theme[free_mid]="#4a5838"
theme[free_end]="#595959"

# CACHED METER (Purple spectrum: Plum → Lavender)
theme[cached_start]="#4a3858"
theme[cached_mid]="#5a4868"
theme[cached_end]="#666666"

# AVAILABLE METER (Cyan spectrum)
theme[available_start]="#2d4848"
theme[available_mid]="#3d5858"
theme[available_end]="#4a7070"

# USED METER (Warning colors: Amber → Coral)
theme[used_start]="#5a5030"
theme[used_mid]="#6a5838"
theme[used_end]="#6a3838"

# ----------------------------------------------------------------------------
# NETWORK GRAPHS
# ----------------------------------------------------------------------------

# DOWNLOAD (Moss Green)
theme[download_start]="#3a4830"
theme[download_mid]="#4a5838"
theme[download_end]="#595959"

# UPLOAD (Sky Cyan)
theme[upload_start]="#2d5060"
theme[upload_mid]="#3d6070"
theme[upload_end]="#4a7070"

# ----------------------------------------------------------------------------
# PROCESS GRAPH
# ----------------------------------------------------------------------------
theme[process_start]="#2d6060"
theme[process_mid]="#3d8080"
theme[process_end]="#4a7070"

# ============================================================================
# OLED VALIDATION - COSMOS SPEC
# ============================================================================
# ✓ Background: 0% luminance (Pixels OFF)
# ✓ Static Borders: 25% luminance (Minimal wear)
# ✓ Peak Brightness: 50% (#808080) only for high CPU alerts
# ✓ Colors: Mapped to sub-pixel friendly Cyan/Teal/Dark Moss
# ============================================================================

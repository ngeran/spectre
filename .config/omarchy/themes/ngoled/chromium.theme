/* ============================================================================
 * Chromium/Chrome Custom Theme - ngoled
 * ============================================================================
 * File format: Simple RGB triplet per line
 * Line 1: Background color (toolbar, new tab page)
 * 
 * For full theming, use Chrome Web Store or create manifest.json
 * This simple file only controls basic background color
 * ============================================================================
 */

/* Pure OLED black background */
0,0,0

/* ============================================================================
 * ADVANCED THEMING (Optional - Create manifest.json)
 * ============================================================================
 * 
 * For complete theme, create a Chrome extension with this structure:
 * 
 * ngoled-chrome/
 *   ├── manifest.json
 *   └── images/
 *       └── theme_ntp_background.png (optional)
 * 
 * manifest.json example:
 * {
 *   "manifest_version": 3,
 *   "name": "ngoled - OLED Dark Theme",
 *   "version": "1.0",
 *   "description": "Pure OLED black theme with cyan accents",
 *   "theme": {
 *     "colors": {
 *       "frame": [0, 0, 0],              // Pure black window frame
 *       "toolbar": [0, 0, 0],            // Pure black toolbar
 *       "tab_text": [200, 200, 200],     // Neutral gray text (#c8c8c8)
 *       "tab_background_text": [184, 184, 184], // Inactive tab text
 *       "bookmark_text": [200, 200, 200],
 *       "ntp_background": [0, 0, 0],     // New tab page black
 *       "ntp_text": [200, 200, 200],
 *       "button_background": [26, 27, 38] // Charcoal buttons
 *     },
 *     "tints": {
 *       "buttons": [0.58, 0.3, 0.6]      // Cyan tint for buttons
 *     }
 *   }
 * }
 * 
 * Then load as unpacked extension in chrome://extensions/
 * ============================================================================
 */

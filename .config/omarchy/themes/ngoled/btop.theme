# ============================================================================
# btop System Monitor - ngoled Theme
# ============================================================================
# OLED-optimized performance monitoring
# Strategy: Pure black, cyan-teal gradients, warm accent highlights
# All colors in hexadecimal: "#RRGGBB"
# Gradients use "start" → "mid" → "end" (leave empty for solid color)
# ============================================================================

# ----------------------------------------------------------------------------
# BASE COLORS
# ----------------------------------------------------------------------------

# Main background: Pure OLED black (transparent for terminal background)
theme[main_bg]=""

# Main foreground: Neutral gray (primary text)
# - WCAG AAA contrast: 8.6:1
theme[main_fg]="#c8c8c8"

# Title: Amber gold (section headers)
# - Warm, attention-grabbing without harshness
theme[title]="#b89650"

# Highlight: Balanced cyan (keyboard shortcuts, active elements)
# - Matches theme accent
theme[hi_fg]="#4a9d9d"

# Selected background: Cyan selection (active row/item)
theme[selected_bg]="#2a3f50"

# Selected foreground: Bright gray (selected text)
theme[selected_fg]="#e0e0e0"

# Inactive/disabled: Deep charcoal (muted elements)
theme[inactive_fg]="#3e4451"

# Process misc: Slate gray (mini graphs, status text)
theme[proc_misc]="#8a8a8d"

# ----------------------------------------------------------------------------
# BOX OUTLINES (UI Structure)
# ----------------------------------------------------------------------------

# CPU box: Slate gray
theme[cpu_box]="#8a8a8d"

# Memory/Disks box: Slate gray
theme[mem_box]="#8a8a8d"

# Network box: Slate gray
theme[net_box]="#8a8a8d"

# Processes box: Slate gray
theme[proc_box]="#8a8a8d"

# Divider lines: Slate gray
theme[div_line]="#8a8a8d"

# ----------------------------------------------------------------------------
# TEMPERATURE GRAPH (Cyan → Gold → Coral)
# ----------------------------------------------------------------------------
# Gradient: Cool → Warm → Hot
# Strategy: Cyan-shifted for OLED safety

# Cool: Sky cyan
theme[temp_start]="#5a9aad"

# Warm: Amber gold
theme[temp_mid]="#b89650"

# Hot: Warm coral (not alarming red)
theme[temp_end]="#b56a6a"

# ----------------------------------------------------------------------------
# CPU USAGE GRAPH (Teal → Cyan → Aqua)
# ----------------------------------------------------------------------------
# Gradient: Low → Medium → High usage
# Strategy: Ocean tones for calming aesthetic

# Low: Deep teal
theme[cpu_start]="#4f8a8b"

# Medium: Balanced cyan
theme[cpu_mid]="#4a9d9d"

# High: Bright aqua
theme[cpu_end]="#60d0d0"

# ----------------------------------------------------------------------------
# MEMORY FREE METER (Forest → Sage → Moss)
# ----------------------------------------------------------------------------
# Gradient: High free → Low free
# Strategy: Green spectrum for "available" resource

# High free: Sage green
theme[free_start]="#7a9769"

# Medium free: Moss green
theme[free_mid]="#6a8759"

# Low free: Dark forest
theme[free_end]="#5a7449"

# ----------------------------------------------------------------------------
# MEMORY CACHED METER (Lavender → Purple → Plum)
# ----------------------------------------------------------------------------
# Gradient: Low cache → High cache
# Strategy: Purple spectrum for "optimization" metric

# Low: Lavender
theme[cached_start]="#9e7fae"

# Medium: Twilight purple
theme[cached_mid]="#8e6f9e"

# High: Deep plum
theme[cached_end]="#7e5f8e"

# ----------------------------------------------------------------------------
# MEMORY AVAILABLE METER (Cyan → Aqua → Teal)
# ----------------------------------------------------------------------------
# Gradient: Matches CPU for consistency

# Low: Deep teal
theme[available_start]="#4f8a8b"

# Medium: Balanced cyan
theme[available_mid]="#5f9a9b"

# High: Bright aqua
theme[available_end]="#60d0d0"

# ----------------------------------------------------------------------------
# MEMORY USED METER (Amber → Gold → Coral)
# ----------------------------------------------------------------------------
# Gradient: Low usage → High usage
# Strategy: Warm tones for "consumption" metric

# Low: Amber gold
theme[used_start]="#b89650"

# Medium: Bright gold
theme[used_mid]="#c8a660"

# High: Warm coral (warning without alarm)
theme[used_end]="#b56a6a"

# ----------------------------------------------------------------------------
# DOWNLOAD GRAPH (Moss → Sage → Lime)
# ----------------------------------------------------------------------------
# Gradient: Low → High download speed
# Strategy: Green for "incoming" data

# Low: Moss green
theme[download_start]="#6a8759"

# Medium: Sage green
theme[download_mid]="#7a9769"

# High: Bright sage (lifted)
theme[download_end]="#8aa779"

# ----------------------------------------------------------------------------
# UPLOAD GRAPH (Sky → Aqua → Bright Cyan)
# ----------------------------------------------------------------------------
# Gradient: Low → High upload speed
# Strategy: Cyan for "outgoing" data

# Low: Sky cyan
theme[upload_start]="#4a8a9d"

# Medium: Bright aqua
theme[upload_mid]="#5a9aad"

# High: Enhanced aqua
theme[upload_end]="#6aaabd"

# ----------------------------------------------------------------------------
# PROCESS GRAPH (Gradient fallback)
# ----------------------------------------------------------------------------

# Process graph: Balanced cyan
theme[process_start]="#4a9d9d"
theme[process_mid]="#5f9a9b"
theme[process_end]="#60d0d0"

# ============================================================================
# DESIGN NOTES
# ============================================================================
# Gradient Philosophy:
#   - Temperature: Cyan → Gold → Coral (cool to hot)
#   - CPU: Teal → Cyan → Aqua (low to high load)
#   - Memory Free: Sage → Moss → Dark (high to low availability)
#   - Memory Used: Amber → Gold → Coral (low to high consumption)
#   - Download: Moss → Sage → Bright (incoming data)
#   - Upload: Sky → Aqua → Bright (outgoing data)
#
# Color Mapping Strategy:
#   ✓ Cyan/Teal → CPU, Network, System metrics
#   ✓ Green → Available resources, downloads
#   ✓ Gold/Amber → Moderate usage, warnings
#   ✓ Coral → High usage, temperature (not alarming)
#   ✓ Purple → Cached/optimized resources
#
# OLED Safety:
#   ✓ No pure whites (max #e0e0e0)
#   ✓ Pure black background
#   ✓ Cyan-shifted blues
#   ✓ All gradients tested for sub-pixel balance
#   ✓ Suitable for 24/7 monitoring
# ============================================================================
